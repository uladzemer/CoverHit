{
  "name": "coverhit",
  "version": "0.1.0",
  "private": true,
  "description": "Browser 3D carpet-beating arcade with soft-body physics and Soviet poster style HUD",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/uladzemer/CoverHit.git" },
  "homepage": "https://uladzemer.github.io/CoverHit/",
  "type": "module",
  "scripts": {
    "audio:build": "node scripts/build-audio.mjs",
    "audio:validate": "node scripts/validate-audio.mjs",
    "verify:audio": "node scripts/verify-audio.mjs",
    "dev": "vite",
    "build": "node scripts/build-carpets.mjs && node scripts/build-lite-assets.mjs && vite build",
    "build:public": "node scripts/build-lite-assets.mjs && vite build",
    "preview": "vite preview",
    "publish:public": "bash scripts/publish-public.sh",
    "verify:release": "node scripts/verify-release.mjs",
    "test": "vitest run",
    "carpets": "node scripts/build-carpets.mjs",
    "carpets:new": "node scripts/new-carpets.mjs",
    "yard:stock": "node scripts/import-yard-stock.mjs",
    "assets:lite": "node scripts/build-lite-assets.mjs",
    "verify:mobile": "node scripts/verify-mobile.mjs",
    "verify:canvas-presented": "node scripts/verify-canvas-presented.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "ffmpeg-static": "^5.3.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5",
    "vite": "^6.4.4",
    "vitest": "^4.1.11",
    "yauzl": "^3.4.0"
  }
}
